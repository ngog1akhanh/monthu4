<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy any images placed in the WelcomeImages folder to the output so the slideshow can find them -->
    <None Include="WelcomeImages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- WebView2: enable embedding modern web content. Restore packages after adding. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1347.30" />
  </ItemGroup>
</Project>