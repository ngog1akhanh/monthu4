<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhFoodTour.Mobile.PoiDetailPage"
             Title="Chi Tiết Quán">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Border Padding="0" StrokeThickness="0" BackgroundColor="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Image Source="{Binding ImageUrl}" 
                       HeightRequest="250" 
                       Aspect="AspectFill" />
            </Border>

            <Label Text="{Binding Name}" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#f97316" />

            <BoxView HeightRequest="1" Color="#e5e7eb" Margin="0,10" />

            <Label Text="📍 Thông tin chi tiết:" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <Label Text="{Binding Description_VI}" 
                   FontSize="16" 
                   LineHeight="1.5" 
                   TextColor="#4b5563" />

            <Button Text="🚗 Chỉ đường đến quán" 
                    Clicked="OnDirectionsClicked"
                    BackgroundColor="#3b82f6" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="8" 
                    Margin="0,20,0,0"
                    Padding="15"/>

            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <Picker x:Name="LanguagePicker" 
                        Title="Chọn ngôn ngữ" 
                        WidthRequest="200"
                        BackgroundColor="#f3f4f6"
                        TextColor="Black">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>🇻🇳 Tiếng Việt</x:String>
                            <x:String>🇬🇧 English</x:String>
                            <x:String>🇨🇳 中文 (Chinese)</x:String>
                            <x:String>🇯🇵 日本語 (Japanese)</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                    <Picker.SelectedIndex>0</Picker.SelectedIndex>
                </Picker>

                <Button x:Name="BtnPlayAudio"
                        Text="🎧 Phát" 
                        Clicked="OnPlayAudioClicked"
                        BackgroundColor="#10b981" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="8" 
                        HorizontalOptions="Fill"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>