<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhFoodTour.Mobile.MainPage"
             Title="Vĩnh Khánh Food Tour">

    <Grid RowDefinitions="Auto, *">

        <Grid ColumnDefinitions="*, Auto" Margin="20,10,20,10">
            <Label Text="Khám Phá Phố Ốc" 
                   FontSize="24" FontAttributes="Bold"
                   TextColor="#f97316" 
                   VerticalOptions="Center" />

            <Button Grid.Column="1" 
                    Text="🗺️ Bản Đồ" 
                    Clicked="OnViewMapClicked"
                    BackgroundColor="#3b82f6" 
                    TextColor="White" 
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="10,5"/>
        </Grid>

        <CollectionView x:Name="PoisList" Grid.Row="1" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="15" Stroke="#eee" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Description_VI}" FontSize="14" TextColor="Gray" MaxLines="2" />
                            <Label Text="📍 Xem vị trí" FontSize="12" TextColor="#3b82f6" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>